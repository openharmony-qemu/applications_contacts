import("//build/ohos.gni")

# The existing entry includes the real Contacts UIExtension and picker pages.
ohos_app("contacts_hap") {
  deps = []
  certificate_profile = "signature/contacts.p7b"
  hap_name = "Contacts"
  part_name = "prebuilt_hap"
  subsystem_name = "applications"
  module_install_dir = "app/com.ohos.contacts"
  sdk_home = "//prebuilts/ohos-sdk/linux"
  sdk_type_name = [ "sdk.dir" ]
  assemble_type = "assembleHap"
  build_level = "module"
  build_modules = [ "entry" ]
  js_build_mode = "release"
}
